# Edge Function secrets. Set them with:  supabase secrets set --env-file .env
# (SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are provided to functions automatically.)

# Browser origin(s) allowed to call the functions, comma separated. Use your real site URL(s).
ALLOWED_ORIGIN=https://app.example.com

# Safaricom Daraja (https://developer.safaricom.co.ke). Start with sandbox, then switch to production.
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
# A long random string. It becomes part of the callback URL: openssl rand -hex 32
MPESA_CALLBACK_SECRET=

# Daraja only accepts Kenyan shillings. Update this when the rate moves (or automate it later).
USD_KES_RATE=129
